# NEXUS environment configuration.
# Copy to `.env` and adjust. NEVER commit real credentials or a real `.env`.

# Demo fallback. When true (default), domains without a detected/connected real
# provider show clearly-labelled demo data. Real providers ALWAYS win when
# viable. Set to false to show empty/"not connected" states instead of demo data.
VITE_DEMO_MODE=true

# Per-domain provider selection: "mock" | "real" | "auto" (default under the
# desktop build: auto for every domain; browser preview: mock).
# - mock: always demo data
# - real: always the real implementation, no demo fallback
# - auto: real when detected/connected, demo fallback otherwise
#VITE_PROVIDER_SYSTEM=auto
#VITE_PROVIDER_STEAM=auto
#VITE_PROVIDER_MEDIA=auto
#VITE_PROVIDER_EMAIL=auto
#VITE_PROVIDER_ASSISTANT=mock

# System safety posture: "observe" (never mutate) | "enabled".
# Keep "observe" on the development laptop.
VITE_SYSTEM_SAFETY=observe

# --- Future integration secrets (NOT read yet; use OS secure storage) ---
# STEAM_API_KEY=
# STEAM_ID=
# GMAIL_CLIENT_ID=
# MS_GRAPH_CLIENT_ID=
