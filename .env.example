# NEXUS environment configuration.
# Copy to `.env` and adjust. NEVER commit real credentials or a real `.env`.

# Global demo mode. When true (default), the app uses high-quality mock/demo
# data everywhere so it looks impressive with zero integrations. Set to false on
# the gaming PC to prefer real providers where available.
VITE_DEMO_MODE=true

# Per-domain provider selection: "mock" | "real" | "auto".
# - mock: always use demo data
# - real: always use the real implementation (may be a stub on the dev laptop)
# - auto: use real when viable (Tauri present, not demo), else mock
VITE_PROVIDER_SYSTEM=auto
VITE_PROVIDER_STEAM=mock
VITE_PROVIDER_MEDIA=mock
VITE_PROVIDER_EMAIL=mock
VITE_PROVIDER_ASSISTANT=mock

# System safety posture: "observe" (never mutate) | "enabled".
# Keep "observe" on the development laptop.
VITE_SYSTEM_SAFETY=observe

# --- Future integration secrets (NOT read yet; use OS secure storage) ---
# STEAM_API_KEY=
# STEAM_ID=
# GMAIL_CLIENT_ID=
# MS_GRAPH_CLIENT_ID=
